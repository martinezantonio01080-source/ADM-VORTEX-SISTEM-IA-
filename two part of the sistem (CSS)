body {
    background-color: #0f172a;
    color: #f8fafc;
    font-family: monospace;
    padding: 20px;
    max-width: 800px;
    margin: auto;
}

h1 {
    color: #38bdf8;
    text-align: center;
}

.subtitle {
    text-align: center;
}

.panel {
    background: #1e293b;
    border: 1px solid #334155;
    padding: 20px;
    border-radius: 8px;
    margin-top: 20px;
}

button {
    background: #0284c7;
    color: white;
    border: none;
    padding: 10px 20px;
    font-size: 16px;
    cursor: pointer;
    border-radius: 4px;
    margin-top: 10px;
}

button:hover { 
    background: #0369a1; 
}

pre {
    background: #090d16;
    padding: 15px;
    border-radius: 5px;
    overflow-x: auto;
    color: #4ade80;
    max-height: 300px;
}
